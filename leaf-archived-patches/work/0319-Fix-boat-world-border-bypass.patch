From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alex <42610166+renwixx@users.noreply.github.com>
Date: Fri, 16 Oct 2026 19:10:12 +0200
Subject: [PATCH] Fix boat world border bypass


diff --git a/net/minecraft/core/dispenser/BoatDispenseItemBehavior.java b/net/minecraft/core/dispenser/BoatDispenseItemBehavior.java
index 0d1b0898f33ad4ad4dd58bb1a2cb3d0a685542d2..3af9f732404592edb2dec9e311d9af8c3fceca5e 100644
--- a/net/minecraft/core/dispenser/BoatDispenseItemBehavior.java
+++ b/net/minecraft/core/dispenser/BoatDispenseItemBehavior.java
@@ -70,6 +70,9 @@ public class BoatDispenseItemBehavior extends DefaultDispenseItemBehavior {
             boat.setInitialPos(event.getVelocity().getX(), event.getVelocity().getY(), event.getVelocity().getZ()); // CraftBukkit
             EntityType.<AbstractBoat>createDefaultStackConfig(level, dispensed, null).apply(boat);
             boat.setYRot(direction.toYRot());
+            if (!level.getWorldBorder().isWithinBounds(boat.getBoundingBox())) {
+                return this.defaultDispenseItemBehavior.dispense(source, dispensed);
+            }
             if (level.addFreshEntity(boat) && shrink) dispensed.shrink(1); // Paper - if entity add was successful and supposed to shrink
         }
 
diff --git a/net/minecraft/world/item/BoatItem.java b/net/minecraft/world/item/BoatItem.java
index 597f14af31e1a1253e5d412af390e200632ba279..66477f188dc98865750ba85ff41bbf0efdc0634d 100644
--- a/net/minecraft/world/item/BoatItem.java
+++ b/net/minecraft/world/item/BoatItem.java
@@ -66,7 +66,7 @@ public class BoatItem extends Item {
 
             boat.setYRot(player.getYRot());
             if (!level.purpurConfig.persistentDroppableEntityDisplayNames) boat.setCustomName(null); // Purpur - Apply display names from item forms of entities to entities and vice versa
-            if (!level.noCollision(boat, boat.getBoundingBox())) {
+            if (!level.getWorldBorder().isWithinBounds(boat.getBoundingBox()) || !level.noCollision(boat, boat.getBoundingBox())) {
                 return InteractionResult.FAIL;
             }
 
