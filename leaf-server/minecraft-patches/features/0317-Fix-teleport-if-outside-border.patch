     }
 
     public void dismountTo(final double x, final double y, final double z) {
-        this.teleportTo(x, y, z); // Paper - diff on change for override
+        Vec3 clamped = clampToWorldBorder(this, x, y, z);
+        this.teleportTo(clamped.x, clamped.y, clamped.z); // Paper - diff on change for override
+    }
+
+    public static Vec3 clampToWorldBorder(final Entity entity, final double x, final double y, final double z) {
+        Level level = entity.level();
+        if (level == null) {
+            return new Vec3(x, y, z);
+        }
+        WorldBorder border = level.getWorldBorder();
+        double halfWidth = entity.getBbWidth() / 2.0;
+        double minAllowedX = border.getMinX() + halfWidth + 1.0E-5;
+        double maxAllowedX = border.getMaxX() - halfWidth - 1.0E-5;
+        double minAllowedZ = border.getMinZ() + halfWidth + 1.0E-5;
+        double maxAllowedZ = border.getMaxZ() - halfWidth - 1.0E-5;
+
+        double clampedX = minAllowedX <= maxAllowedX ? Mth.clamp(x, minAllowedX, maxAllowedX) : border.getCenterX();
+        double clampedZ = minAllowedZ <= maxAllowedZ ? Mth.clamp(z, minAllowedZ, maxAllowedZ) : border.getCenterZ();
+        return new Vec3(clampedX, y, clampedZ);
     }
 
     public void teleportTo(final double x, final double y, final double z) {
